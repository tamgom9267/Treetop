{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "854039c15be740369fe03334f21fe82a",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "MapaNormalPasto (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 522.0000610351563,
            "y": 279.0000305175781,
